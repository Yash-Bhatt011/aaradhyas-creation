# ── Server ─────────────────────────────────────
PORT=5000
NODE_ENV=development
# Dev: leave blank → any localhost port is allowed automatically
# Prod: set to your frontend domain
# FRONTEND_URL=https://aaradhyascreation.com
FRONTEND_URL=

# ── Database (persistence) — SUPABASE (recommended) ─────────────────────
# Leave both blank to use a local JSON file (data/db.json) — fine for local
# dev, BUT this gets WIPED on every redeploy on Render/Railway free tiers.
#
# Recommended: create a free Supabase project (500MB database, free forever,
# no card required) — this also powers your image storage below, so
# everything lives in one place.
#   1. Sign up at https://supabase.com/dashboard/sign-up
#   2. Create a new project (pick any region close to you, set a database password)
#   3. Once created: SQL Editor (left sidebar) → New Query
#   4. Paste the contents of backend/supabase-setup.sql → click Run
#   5. Settings (gear icon) → API → copy "Project URL" and the
#      "service_role" secret key (NOT the "anon" public key — service_role
#      is required so your backend can bypass Row Level Security)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Database (persistence) — MongoDB (alternative) ──────────────────────
# Only needed if you're not using Supabase above. If SUPABASE_URL is set,
# this is ignored entirely.
#   1. Sign up at https://www.mongodb.com/cloud/atlas/register
#   2. Create a free M0 cluster (512MB, free forever)
#   3. Database Access → add a user with a password
#   4. Network Access → Add IP Address → "Allow Access from Anywhere" (0.0.0.0/0)
#   5. Connect → Drivers → copy the connection string and paste below
#   6. Replace <password> with your database user's password
MONGODB_URI=

# ── Image Storage (uploaded photos) — SUPABASE STORAGE (recommended) ────
# Leave blank to save uploads to local disk — fine for local dev, BUT this
# gets WIPED on every redeploy on Render/Railway free tiers. Products,
# banners, and site images will 404 after any restart if left blank in
# production.
#
# If SUPABASE_URL + SUPABASE_SERVICE_KEY are set above, uploads automatically
# go to Supabase Storage too — you just need to create the bucket once:
#   1. Supabase Dashboard → Storage (left sidebar) → New Bucket
#   2. Name it exactly: images
#   3. Toggle "Public bucket" ON (so uploaded photos load in the browser)
#   4. Create bucket — that's it, no further config needed here
SUPABASE_STORAGE_BUCKET=images

# ── Image Storage — Cloudinary (alternative, only used if no Supabase) ──
#   1. Sign up at https://cloudinary.com/users/register/free
#   2. Dashboard → copy the "API Environment variable" value
#      (looks like: cloudinary://123456789:AbCdEfGh@your-cloud-name)
#   3. Paste it below
CLOUDINARY_URL=

# ── Emergency admin reset (no Shell access needed) ──────────────────────
# If you're ever locked out of /admin and can't run a Shell command (e.g. on
# Render's free tier), set RESET_ADMIN=true here, redeploy, then IMMEDIATELY
# remove this variable and redeploy again. This force-updates the admin
# account to match ADMIN_EMAIL/ADMIN_PASSWORD above. Leaving it set is a
# security risk — anyone could redeploy and reset your admin password.
RESET_ADMIN=

# ── Auth ───────────────────────────────────────
# Generate a long random string for production, e.g: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Default admin account (used by `npm run seed` to create the first admin)
ADMIN_EMAIL=admin@aaradhyascreation.com
ADMIN_PASSWORD=ChangeThisPassword123!

# ── Razorpay ───────────────────────────────────
# Get these from https://dashboard.razorpay.com/app/keys
# Leave blank to run the storefront in "test/mock" checkout mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret — makes payment confirmation reliable even if the customer
# closes their browser right after paying (the client-side verify alone
# would miss that). Set up in Razorpay Dashboard → Settings → Webhooks:
#   1. Add webhook URL: https://your-backend.onrender.com/api/payments/razorpay/webhook
#   2. Subscribe to event: payment.captured
#   3. Set any secret string there, paste the same value below
RAZORPAY_WEBHOOK_SECRET=

# ── Order Emails (confirmation + admin alerts) ──────────────────────────
# Leave blank to skip sending real emails (order still completes fine,
# emails are just logged to the console instead). To send real emails,
# the simplest option is Gmail SMTP with an App Password (free, no new
# account needed if you already have Gmail):
#   1. Go to https://myaccount.google.com/apppasswords
#   2. Create an app password for "Mail"
#   3. Fill in the values below using that app password (not your normal Gmail password)
# Any other SMTP provider (Brevo, Zoho Mail, etc.) works too — just change the host/port.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where "new order" alerts get sent — defaults to ADMIN_EMAIL if left blank.
ADMIN_NOTIFY_EMAIL=

# ── Shiprocket ─────────────────────────────────
# Get these from your Shiprocket account (Settings > API)
# Leave blank to run shipping in "mock" mode (orders are saved but not pushed to Shiprocket).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary

# ── Misc ────────────────────────────────────────
FREE_SHIPPING_THRESHOLD=25000
