# ── Server ─────────────────────────────────────
PORT=5000
NODE_ENV=development
# Dev: leave blank → any localhost port is allowed automatically
# Prod: set to your frontend domain
# FRONTEND_URL=https://aaradhyascreation.com
FRONTEND_URL=

# ── Database (persistence) ──────────────────────
# Leave blank to use a local JSON file (data/db.json) — fine for local dev,
# BUT this gets WIPED on every redeploy on Render/Railway free tiers.
#
# For production: create a free MongoDB Atlas cluster (no card required)
#   1. Sign up at https://www.mongodb.com/cloud/atlas/register
#   2. Create a free M0 cluster (512MB, free forever)
#   3. Database Access → add a user with a password
#   4. Network Access → Add IP Address → "Allow Access from Anywhere" (0.0.0.0/0)
#   5. Connect → Drivers → copy the connection string and paste below
#   6. Replace <password> with your database user's password
MONGODB_URI=

# ── Image Storage (uploaded photos) ─────────────
# Leave blank to save uploads to local disk — fine for local dev, BUT this
# gets WIPED on every redeploy on Render/Railway free tiers, same as the
# database issue above. Products, banners, and site images will 404 after
# any restart if this is left blank in production.
#
# Fix: create a free Cloudinary account (25GB storage, free forever)
#   1. Sign up at https://cloudinary.com/users/register/free
#   2. Dashboard → copy the "API Environment variable" value
#      (looks like: cloudinary://123456789:AbCdEfGh@your-cloud-name)
#   3. Paste it below
CLOUDINARY_URL=cloudinary://637317312996747:mPDNtF-7_b3L-3MOIHQxzWih6t8

# ── Emergency admin reset (no Shell access needed) ──────────────────────
# If you're ever locked out of /admin and can't run a Shell command (e.g. on
# Render's free tier), set RESET_ADMIN=true here, redeploy, then IMMEDIATELY
# remove this variable and redeploy again. This force-updates the admin
# account to match ADMIN_EMAIL/ADMIN_PASSWORD above. Leaving it set is a
# security risk — anyone could redeploy and reset your admin password.
RESET_ADMIN=

# ── Auth ───────────────────────────────────────
# Generate a long random string for production, e.g: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Default admin account (used by `npm run seed` to create the first admin)
ADMIN_EMAIL=admin@aaradhyascreation.com
ADMIN_PASSWORD=ChangeThisPassword123!

# ── Razorpay ───────────────────────────────────
# Get these from https://dashboard.razorpay.com/app/keys
# Leave blank to run the storefront in "test/mock" checkout mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Shiprocket ─────────────────────────────────
# Get these from your Shiprocket account (Settings > API)
# Leave blank to run shipping in "mock" mode (orders are saved but not pushed to Shiprocket).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary

# ── Misc ────────────────────────────────────────
FREE_SHIPPING_THRESHOLD=25000
