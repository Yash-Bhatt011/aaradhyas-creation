# ── Server ─────────────────────────────────────
PORT=5000
NODE_ENV=development
# Dev: leave blank → any localhost port is allowed automatically
# Prod: set to your frontend domain
# FRONTEND_URL=https://aaradhyascreation.com
FRONTEND_URL=

# ── Auth ───────────────────────────────────────
# Generate a long random string for production, e.g: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Default admin account (used by `npm run seed` to create the first admin)
ADMIN_EMAIL=admin@aaradhyascreation.com
ADMIN_PASSWORD=ChangeThisPassword123!

# ── Razorpay ───────────────────────────────────
# Get these from https://dashboard.razorpay.com/app/keys
# Leave blank to run the storefront in "test/mock" checkout mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Shiprocket ─────────────────────────────────
# Get these from your Shiprocket account (Settings > API)
# Leave blank to run shipping in "mock" mode (orders are saved but not pushed to Shiprocket).
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary

# ── Misc ────────────────────────────────────────
FREE_SHIPPING_THRESHOLD=25000

# ── Anthropic AI Stylist ───────────────────────────────────────────────
# Get from https://console.anthropic.com/
# Leave blank to disable the AI Saree Stylist feature on the storefront.
ANTHROPIC_API_KEY=
